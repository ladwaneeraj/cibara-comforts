# Analytics. Every one of these is optional: leave a variable unset and that
# tag is never loaded at all. See docs/DEPLOYMENT.md.
#
# These are inlined at build time because the site is a static export, so
# changing one requires a rebuild rather than just a redeploy.

# Google Analytics 4
NEXT_PUBLIC_GA4_ID=

# Microsoft Clarity. Recommended: enable for a week when you want session
# recordings, then remove it.
NEXT_PUBLIC_CLARITY_ID=

# Meta Pixel. Only worth adding while you are actually running ads.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads conversion tracking.
#
# Unlike the three above, these two are load-bearing: the Performance Max
# campaign bids on the conversions they report, so leaving them unset means
# paying for clicks that smart bidding cannot learn from. The deploy workflow
# fails the build if the id is missing, deliberately.
#
# The id is the account destination ("AW-..."). The label identifies the single
# "Contact" conversion action and is found under
# Goals > Conversions > Contact > Data sources > Manage.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
